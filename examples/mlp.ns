// NeuralScript example: MLP classifier with compile-time shape verification
// and an AOT-compiled training step (train()) that shares the network weights.
//
// Build & inspect:
//   ./build/nsc examples/mlp.ns --check     # static shape verification only
//   ./build/nsc examples/mlp.ns --mlir      # dump MLIR lowering
//   ./build/nsc examples/mlp.ns --cuda      # generate CUDA backend
//   ./build/nsc examples/mlp.ns --cpp       # generate CPU reference backend

// ---- Type aliases: symbolic + constant dimensions ----
type Batch    = Dynamic     // symbolic batch dim, resolved at runtime entry
type Features = 784         // constant
type Classes  = 10          // constant

// ---- Model definition: single weight set per layer ----
network MLPClassifier {
    input:  Tensor[Batch, Features] float32
    output: Tensor[Batch, Classes] float32

    layer fc1  = Dense(in: Features, out: 512, activation: ReLU)
    layer drop = Dropout(rate: 0.1)
    layer fc2  = Dense(in: 512, out: Classes, activation: Identity)

    forward(x) {
        return x -> fc1 -> drop -> fc2
    }

    // Training step: the grad{} block drives the compiler's AOT reverse-mode
    // lowering. Layer names (fc1, fc2) bind directly to the network weight
    // tensors (fc1_w, fc2_w) -- no duplicated w1/w2. The compiler appends the
    // optimizer step (Muon for matrices, AdamW otherwise) after the backward
    // tape, and the C-ABI exposes it as ns_runtime_train_step.
    train(batch_x: Tensor[Batch, Features],
          batch_y: Tensor[Batch, Classes]) -> float32 {
        grad {
            var hidden = batch_x @ fc1
            var act    = relu(hidden)
            var preds  = act @ fc2
            var loss   = cross_entropy(preds, batch_y)
        }
        return loss
    }
}

// Compile-time checks performed here:
//   forward: [Batch, 784] -> fc1 -> drop -> fc2 -> [Batch, 10]
//   train:   [Batch, 784] @ [784, 512] -> relu -> @ [512, 10] -> cross_entropy
// Any shape mismatch in '@' aborts the build with an exact diagnostic before
// any runtime code is produced.